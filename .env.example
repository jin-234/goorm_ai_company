# Upstage Solar 키. 넣으면 아침 PT 체크리스트와 주간보고 답장을 Solar가 만듭니다.
# 비워 두면 서버 안 규칙(PTParser)과 정해진 문구의 기본 답장으로 동작합니다.
UPSTAGE_API_KEY=
# 선택: 기본값 https://api.upstage.ai/v1 · solar-pro4 · 30초
UPSTAGE_BASE_URL=
UPSTAGE_MODEL=
UPSTAGE_TIMEOUT=

# Supabase Postgres 연결 주소. Supabase → Connect → Transaction pooler(포트 6543) 주소를 넣습니다.
# Vercel의 Supabase 연동을 쓰면 POSTGRES_URL이 자동으로 들어가므로 비워 둬도 됩니다.
# 둘 다 비워 두면 메모리에 저장합니다(로컬 개발용).
DATABASE_URL=

# OpenAI 키. 넣으면 아침 PT에서 '말로 하기'(녹음 → 글)가 켜집니다.
# 비워 두면 녹음 버튼 대신 글 입력만 보입니다.
OPENAI_API_KEY=
# 선택: 기본값 gpt-4o-transcribe · https://api.openai.com/v1 · 40초
OPENAI_STT_MODEL=
OPENAI_BASE_URL=
OPENAI_STT_TIMEOUT=
